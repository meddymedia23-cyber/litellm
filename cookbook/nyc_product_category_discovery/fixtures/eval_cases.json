      "expected": {"supported": ["Bronx|Celebration Kits", "Bronx|Gift Baskets"], "top": "Bronx|Celebration Kits", "top_count": 2, "priority_borough": null, "priority_status": "insufficient_data"}
    },
    {
      "case_id": "completed-zero-supply",
